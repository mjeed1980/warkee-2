async function exportShiftExcel(id){
  const sh=await dbGet('shifts',id);if(!sh){toast('غير موجود','bad');return;}
  const c=shiftCalc(sh),d=diffInfo(c.diff);
  if(typeof ExcelJS==='undefined'){
    dlCSV([['تشيك مناوبة',sh.worker,sh.date],[],
      ['المضخة','النوع','السابقة','الحالية','الكمية','القيمة'],
      ...sh.meters.map(m=>{const q=meterQty(m);const pr=m.type==='diesel'?num(sh.prices.diesel):num(sh.prices.petrol);
        return [m.name,m.type==='diesel'?'ديزل':'بنزين',m.prev,m.curr,q===null?'—':q,q!==null&&q>=0?q*pr:'—'];}),[],
      ['قيمة العدادات',c.meterValue],['تحصيلات',c.collections],['بيع بالأجل',c.credits],['مصروفات',c.expenses],
      ['نقص محمل',c.prevShortage],['المطلوب',c.required],['المودع',c.deposited],['الفرق',c.diff,d.label]],
      'تشيك-'+sh.worker+'-'+sh.date+'.csv');return;
  }
  const wb=new ExcelJS.Workbook();wb.creator='مدير الحسابات';
  const ws=wb.addWorksheet('تشيك مناوبة',{views:[{rightToLeft:true}]});
  ws.columns=[{width:6},{width:20},{width:10},{width:13},{width:13},{width:13},{width:14}];
  exTitle(ws,'تشيك مناوبة — '+sh.worker+' — '+sh.date,7);
