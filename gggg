function printShell(title,body){
  const w=window.open('','_blank');
  const html='<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>'+escapeHtml(title)+'</title><style>'+
  '@page{size:A4;margin:12mm}*{box-sizing:border-box;margin:0;padding:0}'+
  'body{font-family:"Segoe UI",Tahoma,sans-serif;color:#1e293b;font-size:13px}'+
  '.hdr{display:flex;justify-content:space-between;border-bottom:3px solid #1e3a5f;padding-bottom:10px;margin-bottom:12px}'+
  '.hdr h1{color:#1e3a5f;font-size:20px}.meta{color:#64748b;font-size:12px;text-align:left;line-height:1.7}'+
  'table{width:100%;border-collapse:collapse;margin-bottom:8px}'+
  'th{background:#1e3a5f;color:#fff;padding:6px 8px;border:1px solid #152b47;font-size:12px}'+
  'td{border:1px solid #cbd5e1;padding:5px 8px}tbody tr:nth-child(even) td{background:#f8fafc}'+
  '.c{text-align:center}.qty{font-weight:800}.tot td{font-weight:800;background:#f0faf6!important}'+
  '.sec{color:#1e3a5f;font-weight:800;margin:12px 0 6px;border-right:4px solid #1e3a5f;padding-right:8px}'+
  '.badge{display:inline-block;padding:2px 12px;border-radius:999px;font-weight:800;font-size:11px}'+
  '.sign{display:flex;justify-content:space-around;margin-top:34px;color:#475569}'+
  '.sign div{width:200px;text-align:center;border-top:1.5px solid #94a3b8;padding-top:6px;font-size:12px}'+
  '</style></head><body>'+body+
  '<div style="margin-top:16px;color:#94a3b8;font-size:10px;text-align:center;border-top:1px dashed #cbd5e1;padding-top:6px">أُنشئ آلياً بواسطة نظام مدير الحسابات — محطة الوقود</div></body></html>';
  if(w&&w.document){w.document.open();w.document.write(html);w.document.close();
    setTimeout(()=>{try{w.focus();w.print();}catch(e){}},450);return;}
  const fr=document.createElement('iframe');
  fr.style.cssText='position:fixed;left:-9999px;width:0;height:0;border:0';
  document.body.appendChild(fr);
  const doc=fr.contentWindow.document;doc.open();doc.write(html);doc.close();
  setTimeout(()=>{try{fr.contentWindow.focus();fr.contentWindow.print();}catch(e){}},450);
  setTimeout(()=>fr.remove(),60000);
  toast('اختر «حفظ كـ PDF» من نافذة الطباعة','',4000);
}
