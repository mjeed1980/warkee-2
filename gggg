    exC(ws,r,4,m.prev==null?'':m.prev,{numFmt:'#,##0.00',align:'center'});
    exC(ws,r,5,m.curr==null?'':m.curr,{numFmt:'#,##0.00',align:'center'});
    exC(ws,r,6,q===null?'—':q,{numFmt:'#,##0.00',bold:true,align:'center'});
    exC(ws,r,7,(q!==null&&q>=0)?q*pr:'—',{numFmt:'#,##0.00',align:'center'});r++;});
  const row=(l,v,hot)=>{exC(ws,r,1,l,{bold:true});ws.mergeCells(r,1,r,5);
    exC(ws,r,6,v,{numFmt:'#,##0.00',align:'center',bold:!!hot,fill:hot?'FFFFF7D6':undefined});r++;};
  row('قيمة العدادات (سلطة التشيك)',c.meterValue,true);
  row('مبيعات مبلَّغة (بنزين '+fmtQty(c.repP)+' / ديزل '+fmtQty(c.repD)+')',c.repCash||'');
  row('فرق الكمية: بنزين '+fmtQty(c.diffP)+' • ديزل '+fmtQty(c.diffD),'',{});
  row('تحصيلات / إيرادات إضافية',c.collections);
  row('بيع بالأجل (ديون عملاء)',c.credits);
  row('مصروفات',c.expenses);
  row('نقص سابق محمَّل',c.prevShortage);
  row('المطلوب من العامل',c.required,true);
  row('المودَع',c.deposited,true);
  exC(ws,r,1,'الفرق: '+d.label,{bold:true,fill:d.cls==='st-short'?'FFFEE2E2':d.cls==='st-plus'?'FFFEF3C7':'FFDCFCE7'});
  ws.mergeCells(r,1,r,5);
  exC(ws,r,6,c.diff,{numFmt:'#,##0.00',bold:true,align:'center',
    fill:d.cls==='st-short'?'FFFEE2E2':d.cls==='st-plus'?'FFFEF3C7':'FFDCFCE7'});
  downloadBlob(new Blob([await wb.xlsx.writeBuffer()],{type:XLSX_TYPE}),'تشيك-'+sh.worker+'-'+sh.date+'.xlsx');
  toast('📊 تم التنزيل','good');
}
