<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1e3a5f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="format-detection" content="telephone=no">
<title>🧾 مدير الحسابات — محطة الوقود</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js" defer></script>
<style>
:root{
  --bg:#eef1f6; --card:#fff; --ink:#1e293b; --muted:#64748b; --line:#e2e8f0;
  --primary:#1e3a5f; --primary-dark:#152b47; --accent:#b45309;
  --danger:#dc2626; --danger-bg:#fee2e2; --success:#16a34a; --warn-bg:#fef3c7;
  --radius:16px; --shadow:0 1px 3px rgba(15,23,42,.08),0 4px 14px rgba(15,23,42,.06);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:'Tajawal',Tahoma,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;
  padding-bottom:calc(74px + env(safe-area-inset-bottom))}
button{font-family:inherit;cursor:pointer}
input,select{font-family:inherit;font-size:16px}
.hidden{display:none!important}
header{background:linear-gradient(135deg,#1e3a5f,#0f2440);color:#fff;padding:14px 16px;position:sticky;top:0;z-index:30;box-shadow:var(--shadow)}
.header-inner{max-width:720px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:8px}
header h1{font-size:1.1rem;font-weight:800}
.header-date{background:rgba(255,255,255,.15);padding:5px 12px;border-radius:999px;font-size:.8rem;white-space:nowrap}
main{max-width:720px;margin:0 auto;padding:12px 12px 24px}
.tab-panel{display:none}.tab-panel.active{display:block;animation:fade .22s}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;margin-bottom:12px}
.card h2{font-size:1rem;font-weight:800;margin-bottom:10px;color:var(--primary-dark)}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}
.card-head h2{margin-bottom:0}
.hint{color:var(--muted);font-size:.8rem;margin-bottom:8px}
.btn{border:none;border-radius:12px;padding:11px 16px;font-size:.92rem;font-weight:800;transition:.15s;
  min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:5px}
.btn:active{transform:scale(.96)}
.btn-primary{background:var(--primary);color:#fff}
.btn-accent{background:var(--accent);color:#fff}
.btn-success{background:var(--success);color:#fff}
.btn-danger{background:var(--danger);color:#fff}
.btn-outline{background:#fff;border:1.5px solid var(--primary);color:var(--primary)}
.btn-block{width:100%}
.btn-small{padding:7px 10px;font-size:.78rem;border-radius:10px;min-height:36px}
.btn-view{background:#e0f2fe;color:#075985}
.btn-edit{background:#fef9c3;color:#a16207}
.btn-del{background:var(--danger-bg);color:var(--danger)}
.btn-pdf{background:#dbeafe;color:#1d4ed8}
.btn-xls{background:#dcfce7;color:#15803d}
.btn-icon{border:none;background:var(--danger-bg);color:var(--danger);width:40px;height:40px;border-radius:12px;font-size:1rem;flex-shrink:0}
input[type=text],input[type=number],input[type=date],select{border:1.5px solid var(--line);border-radius:12px;
  padding:10px 12px;font-size:16px;background:#fff;color:var(--ink);outline:none;width:100%;min-height:46px}
input:focus,select:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(30,58,95,.12)}
.date-row{display:flex;gap:8px}.date-row input{flex:1}
.row2{display:grid;grid-template-columns:1fr auto;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.badge{padding:3px 12px;border-radius:999px;font-size:.8rem;font-weight:800;white-space:nowrap}
.st-short{background:var(--danger-bg);color:var(--danger)}
.st-plus{background:var(--warn-bg);color:#92400e}
.st-ok{background:#dcfce7;color:var(--success)}
.k-badge{padding:2px 10px;border-radius:999px;font-size:.72rem;font-weight:700;white-space:nowrap}
.kb-p{background:#fef3c7;color:#b45309}.kb-d{background:#dcfce7;color:#15803d}
.sum-row{display:flex;justify-content:space-between;align-items:center;gap:6px;padding:9px 11px;background:#f8fafc;border-radius:12px;border:1px solid var(--line);font-size:.88rem}
.sum-row b{font-weight:800}
.sum-row.total{background:#fffbeb;border-color:#fde68a}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0}
.pos{color:var(--success)}.neg{color:var(--danger)}
.empty-msg{text-align:center;color:var(--muted);padding:12px;font-size:.88rem}
.toast{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:99;padding:11px 20px;border-radius:14px;
  font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,.28);transition:opacity .3s;max-width:92vw;text-align:center;
  background:#1e293b;color:#fff;opacity:0;pointer-events:none;font-size:.88rem}
.toast.good{background:#065f46}.toast.bad{background:#7f1d1d}

/* ==== بطاقة مناوبة ==== */
.shift-card{border:1.5px solid var(--line);border-radius:14px;padding:12px;margin-bottom:10px;background:#fff}
.sc-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}
.sc-worker{font-weight:800;color:var(--primary-dark);font-size:.98rem}
.sc-date{color:var(--muted);font-size:.72rem}
.sc-meters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.sc-meters>span{background:#f1f5f9;border:1px solid var(--line);border-radius:999px;padding:3px 10px;font-size:.75rem;font-weight:700}
.sc-meters>span.warn{background:var(--warn-bg);border-color:#fde68a;color:#92400e}
.sc-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:8px}
.sc-stats>div{background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:6px 8px;text-align:center}
.sc-stats span{display:block;font-size:.66rem;color:var(--muted)}
.sc-stats b{font-size:.85rem}
.sc-actions{display:flex;gap:6px;flex-wrap:wrap}

/* ==== صفحة المناوبة (ملء الشاشة) ==== */
.page{position:fixed;inset:0;background:var(--bg);z-index:45;overflow-y:auto;padding-bottom:30px}
.page-head{background:linear-gradient(135deg,#1e3a5f,#0f2440);color:#fff;padding:12px 16px;display:flex;
  justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}
.page-head h2{font-size:1rem}
.page-body{max-width:720px;margin:0 auto;padding:12px}
.f-sec{background:#fff;border-radius:14px;box-shadow:var(--shadow);padding:12px;margin-bottom:10px}
.f-sec h3{font-size:.9rem;font-weight:800;color:var(--primary-dark);margin-bottom:8px}
.f-sec h3 small{color:var(--muted);font-weight:500}
.pump-card{border:1.5px solid var(--line);border-radius:12px;padding:9px;margin-bottom:8px;background:#fbfdfe}
.pc-top{display:flex;gap:8px;margin-bottom:8px}.pc-top input{flex:1}
.pc-mid{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap}
.seg{display:flex;background:#eef2f6;border-radius:10px;padding:3px;gap:3px}
.seg-btn{border:none;background:transparent;padding:5px 14px;border-radius:8px;font-weight:800;font-size:.8rem;color:#64748b;min-height:34px}
.seg-btn.on-petrol{background:#b45309;color:#fff}
.seg-btn.on-diesel{background:#16a34a;color:#fff}
.qty-badge{font-weight:800;font-size:.8rem;background:#f1f5f9;border:1px solid var(--line);border-radius:999px;padding:4px 10px}
.qty-badge.ok{background:#f0fdfa;border-color:#99f6e4;color:#115e59}
.qty-badge.neg{background:var(--danger-bg);border-color:#fecaca;color:var(--danger)}
.pc-bottom{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.pc-bottom label,.l-row label{font-size:.72rem;font-weight:700;color:var(--muted);display:block;margin-bottom:2px}
.l-row{border:1px dashed var(--line);border-radius:12px;padding:9px;margin-bottom:8px;display:grid;gap:6px}
.l-row .lr-grid{display:grid;grid-template-columns:1fr 110px auto;gap:6px;align-items:end}
.l-row .lr-grid.g3{grid-template-columns:1fr 110px auto}
.l-del{border:none;background:var(--danger-bg);color:var(--danger);width:40px;height:44px;border-radius:12px;font-size:.95rem}
.final-box{background:#f0fdf4;border:1.5px solid #86efac;border-radius:14px;padding:12px;margin-bottom:10px}
.final-box .fr{display:flex;justify-content:space-between;align-items:center;padding:5px 0;font-size:.9rem}
.final-box .fr.big{font-size:1.05rem;font-weight:800;border-top:1px dashed #86efac;margin-top:5px;padding-top:9px}
.warn-box{background:var(--warn-bg);border:1px solid #fde68a;color:#92400e;border-radius:12px;padding:9px 12px;font-size:.82rem;font-weight:700;margin-bottom:10px}

/* ==== شريط التنقل ==== */
.bottom-nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1px solid var(--line);
  padding-bottom:env(safe-area-inset-bottom);z-index:40;box-shadow:0 -4px 18px rgba(0,0,0,.07)}
.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;padding:7px 2px 6px;border:none;
  background:none;color:#64748b;font-size:.66rem;font-weight:700}
.nav-btn .ico{font-size:1.3rem;line-height:1.15}
.nav-btn.active{color:var(--primary)}

/* ==== النافذة السفلية ==== */
.sheet-overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:60;opacity:0;pointer-events:none;transition:opacity .25s}
.sheet-overlay.open{opacity:1;pointer-events:auto}
.sheet{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:22px 22px 0 0;max-height:90vh;
  display:flex;flex-direction:column;transform:translateY(100%);transition:transform .28s;z-index:61;padding-bottom:env(safe-area-inset-bottom)}
.sheet-overlay.open .sheet{transform:none}
.sheet-head{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line)}
.sheet-head h3{color:var(--primary-dark);font-size:.98rem}
#sheetClose{border:none;background:var(--danger-bg);color:var(--danger);width:36px;height:36px;border-radius:50%;font-weight:700}
.sheet-body{overflow-y:auto;padding:14px 16px}
.led-row{display:grid;grid-template-columns:1fr auto;gap:4px;padding:9px 4px;border-bottom:1px dashed var(--line);font-size:.85rem}
.led-row .lr1{display:flex;justify-content:space-between;gap:6px;align-items:center}
.led-row .lr2{display:flex;justify-content:space-between;gap:6px;align-items:center;color:var(--muted);font-size:.76rem}
.led-row .amt-d{color:var(--danger);font-weight:800}
.led-row .amt-c{color:var(--success);font-weight:800}
.led-row .bal{font-weight:800;color:var(--primary-dark)}
.cust-item{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:11px 6px;border-bottom:1px dashed var(--line)}
.cust-item .cname{font-weight:700;font-size:.95rem}
.cust-item .cbal{font-weight:800;white-space:nowrap}
.info-box{background:#fffbeb;border:1px solid #fde68a;border-radius:12px;padding:10px 12px;font-size:.82rem;margin-top:10px}
.info-box b{color:#92400e}
ol.steps{padding-right:20px;font-size:.82rem;color:#475569}
ol.steps li{margin-bottom:3px}
.worker-item{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:11px 6px;border-bottom:1px dashed var(--line)}
.worker-item .wname{font-weight:700}
.worker-item .wstat{font-size:.72rem;color:var(--muted)}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <h1>🧾 مدير الحسابات</h1>
    <div class="header-date" id="headerDate"></div>
  </div>
</header>

<main>
<!-- ============ اليوم ============ -->
<section id="tab-day" class="tab-panel active">
  <div class="card">
    <div class="date-row">
      <input type="date" id="dayDate">
      <button class="btn btn-outline" id="btnDayToday">اليوم</button>
    </div>
  </div>
  <div class="card" id="dayTotalsCard">
    <div class="card-head"><h2>📊 ملخص اليوم</h2></div>
    <div id="dayTotals"><div class="empty-msg">⏳</div></div>
    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
      <button class="btn btn-xls" style="flex:1" id="btnDayExcel">📊 Excel اليوم</button>
      <button class="btn btn-pdf" style="flex:1" id="btnDayPdf">🖨️ PDF اليوم</button>
    </div>
  </div>
  <button class="btn btn-primary btn-block" id="btnAddShift" style="margin-bottom:12px">➕ مناوبة جديدة (تشيك عامل)</button>
  <div id="dayShifts"></div>
</section>

<!-- ============ العمال ============ -->
<section id="tab-workers" class="tab-panel">
  <div class="card">
    <h2>👷 العمال</h2>
    <p class="hint">اضغط على أي عامل لعرض سجل مناوباته والنقص المفتوح عليه.</p>
    <div class="row2" style="margin-bottom:10px">
      <input type="text" id="newWorkerName" placeholder="اسم العامل الجديد">
      <button class="btn btn-primary" id="btnAddWorker">+ إضافة</button>
    </div>
    <div id="workersList"></div>
  </div>
</section>

<!-- ============ العملاء ============ -->
<section id="tab-customers" class="tab-panel">
  <div class="card">
    <div class="card-head">
      <h2>👥 كشوف العملاء (<span id="custCount">0</span>)</h2>
      <button class="btn btn-primary btn-small" id="btnAddCustomer">+ عميل</button>
    </div>
    <p class="hint">كل دين (بيع بالأجل) أو تحصيل يُرحَّل تلقائياً هنا لكشف حساب العميل برصيد متجدد — كما في الدفتر اليدوي.</p>
    <input type="text" id="custSearch" placeholder="🔍 بحث باسم العميل..." style="margin-bottom:8px">
    <div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
      <button class="btn btn-pdf btn-small" id="btnPrintBalances" style="flex:1">🖨️ طباعة أرصدة الكل</button>
      <button class="btn btn-xls btn-small" id="btnCustExcel" style="flex:1">📊 Excel العملاء</button>
    </div>
    <div id="customersList"></div>
  </div>
</section>

<!-- ============ أدوات ============ -->
<section id="tab-tools" class="tab-panel">
  <div class="card">
    <h2>🛠️ تصدير ونسخ احتياطي</h2>
    <button class="btn btn-xls btn-block" id="btnExportAll" style="margin-bottom:8px">📊 تصدير شامل (Excel — 4 أوراق)</button>
    <button class="btn btn-primary btn-block" id="btnBackup" style="margin-bottom:8px">⬇️ نسخة احتياطية (ملف)</button>
    <button class="btn btn-outline btn-block" id="btnRestore">⬆️ استعادة نسخة احتياطية</button>
    <input type="file" id="restoreFile" accept=".json" hidden>
  </div>
  <div class="card">
    <h2>📥 استيراد مناوبات العمال</h2>
    <p class="hint">من تطبيق العامل: نسخ احتياطية ← تصدير. أرسل الملف لهاتفك واختره هنا ليتم إنشاء مناوبات جاهزة للتشيك.</p>
    <button class="btn btn-accent btn-block" id="btnImportWorker">📥 استيراد ملف تطبيق عامل</button>
    <input type="file" id="importFile" accept=".json" hidden>
  </div>
  <div class="card">
    <h2>📌 روتين التشيك اليومي</h2>
    <ol class="steps">
      <li>اختر التاريخ ثم «➕ مناوبة جديدة» واختر العامل.</li>
      <li>أدخل قراءات العدادات (سابقة/حالية) وأسعار اللتر — الكمية والقيمة تُحسب آلياً.</li>
      <li>أدخل ما أبلغ عنه العامل (كميات/نقدية) → النظام يقارن ويظهر الفرق فوراً.</li>
      <li>سجّل التحصيلات والديون (بيع بالأجل) والمصروفات — الديون والتحصيلات تُرحَّل تلقائياً لكشوف العملاء.</li>
      <li>النقص المفتوح من آخر مناوبة يُحمَّل تلقائياً على المطلوب (قابل للتعديل).</li>
      <li>أدخل المبلغ المودَع في نهاية المناوبة → يظهر الفرق: نقص على العامل / زيادة / مطابق.</li>
    </ol>
    <div class="info-box"><b>معادلة المطلوب:</b> قيمة الوقود بالعدادات + التحصيلات − المصروفات − البيع بالأجل + نقص سابق. الفرق = المطلوب − المودَع.</div>
  </div>
</section>
</main>

<!-- ============ صفحة المناوبة ============ -->
<div id="shiftPage" class="page hidden">
  <div class="page-head">
    <h2 id="shiftPageTitle">➕ مناوبة جديدة</h2>
    <button class="btn btn-small" style="background:rgba(255,255,255,.2);color:#fff" id="btnShiftBack">✕ رجوع</button>
  </div>
  <div class="page-body">
    <div class="f-sec">
      <h3>👷 العامل والتاريخ</h3>
      <div style="display:grid;gap:8px">
        <select id="fWorker"><option value="">— اختر العامل —</option></select>
        <input type="date" id="fDate">
      </div>
    </div>

    <div class="f-sec">
      <div class="card-head"><h3>⛽ قراءات العدادات <small>(السلطة المرجعية للتشيك)</small></h3>
        <button class="btn btn-primary btn-small" id="btnAddMeter">+ مضخة</button></div>
      <div class="row3" style="margin-bottom:10px">
        <div><label>سعر لتر البنزين</label><input type="number" id="fPriceP" inputmode="decimal" step="any" placeholder="0.00"></div>
        <div><label>سعر لتر الديزل</label><input type="number" id="fPriceD" inputmode="decimal" step="any" placeholder="0.00"></div>
      </div>
      <div id="fMeters"></div>
    </div>

    <div class="f-sec">
      <h3>📋 ما أبلغ عنه العامل <small>(للمطابقة)</small></h3>
      <div class="row3">
        <div><label>بنزين مبلَّغ (لتر)</label><input type="number" id="fRepP" inputmode="decimal" step="any" placeholder="اختياري"></div>
        <div><label>ديزل مبلَّغ (لتر)</label><input type="number" id="fRepD" inputmode="decimal" step="any" placeholder="اختياري"></div>
      </div>
      <div style="margin-top:8px"><label>النقدية المبلَّغة من المبيعات (اختياري)</label>
        <input type="number" id="fRepCash" inputmode="decimal" step="any" placeholder="اختياري"></div>
      <div id="fMatchBox"></div>
    </div>

    <div class="f-sec">
      <div class="card-head"><h3>💰 تحصيل ديون / إيرادات إضافية</h3>
        <button class="btn btn-success btn-small" id="btnAddCollection">+ إضافة</button></div>
      <p class="hint">مع اسم العميل يُخصم من دينه في كشف حسابه تلقائياً. بدون اسم = إيراد عام.</p>
      <div id="fCollections"></div>
    </div>

    <div class="f-sec">
      <div class="card-head"><h3>🧾 بيع بالأجل (ديون جديدة)</h3>
        <button class="btn btn-danger btn-small" id="btnAddCredit">+ إضافة</button></div>
      <p class="hint">يُرحَّل تلقائياً كدين على العميل في كشف حسابه.</p>
      <div id="fCredits"></div>
    </div>

    <div class="f-sec">
      <div class="card-head"><h3>💸 مصروفات مدفوعة من الصندوق</h3>
        <button class="btn btn-accent btn-small" id="btnAddExpense">+ إضافة</button></div>
      <div id="fExpenses"></div>
    </div>

    <div class="f-sec">
      <h3>🧮 الحساب النهائي</h3>
      <div class="row3" style="margin-bottom:10px">
        <div><label>نقص سابق محمَّل على العامل</label><input type="number" id="fPrevShort" inputmode="decimal" step="any" value="0"></div>
        <div><label>💵 المبلغ المودَع نهاية المناوبة</label><input type="number" id="fDeposited" inputmode="decimal" step="any" placeholder="0"></div>
      </div>
      <div id="fSummary"></div>
      <button class="btn btn-primary btn-block" id="btnShiftSave" style="margin-top:10px">💾 حفظ المناوبة والترحيل</button>
    </div>
  </div>
</div>

<!-- نافذة سفلية -->
<div class="sheet-overlay" id="sheetOverlay">
  <div class="sheet">
