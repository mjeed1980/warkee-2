async function backup(){
  const [shifts,workers,customers,ledger]=await Promise.all([dbAll('shifts'),dbAll('workers'),dbAll('customers'),dbAll('ledger')]);
  if(!shifts.length&&!customers.length){toast('لا توجد بيانات','bad');return;}
  const d=new Date();
  const stamp=d.getFullYear()+String(d.getMonth()+1).padStart(2,'0')+String(d.getDate()).padStart(2,'0')+'-'+String(d.getHours()).padStart(2,'0')+String(d.getMinutes()).padStart(2,'0');
  downloadBlob(new Blob([JSON.stringify({app:'station-manager',version:1,shifts,workers,customers,ledger},null,2)],{type:'application/json'}),'نسخة-المدير-'+stamp+'.json');
  toast('✅ تم التنزيل','good');
}
function restore(file){
  const rd=new FileReader();
  rd.onload=async()=>{
    try{
      const data=JSON.parse(String(rd.result));
      if(data.app!=='station-manager')throw new Error('الملف ليس نسخة نظام المدير');
      if(!confirm('سيتم استبدال كل البيانات الحالية ببيانات الملف. متابعة؟'))return;
      for(const st of ['shifts','workers','customers','ledger']){
        const all=await dbAll(st);
        for(const o of all)await dbDel(st,o.id);
      }
      for(const w of (data.workers||[]))await dbPut('workers',w);
      for(const c of (data.customers||[]))await dbPut('customers',c);
      for(const s of (data.shifts||[]))await dbPut('shifts',s);
      for(const l of (data.ledger||[]))await dbPut('ledger',l);
      toast('✅ تمت الاستعادة','good');renderAll();
    }catch(e){toast('فشل: '+e.message,'bad',5000);}
  };
  rd.readAsText(file);
}
function importWorkerFile(file){
  const rd=new FileReader();
  rd.onload=async()=>{
    try{
      const data=JSON.parse(String(rd.result));
      const days=Array.isArray(data)?data:(Array.isArray(data.days)?data.days:null);
      if(!days)throw new Error('الملف ليس نسخة تطبيق عامل');
      const wn=prompt('اسم العامل الذي ستُنسب له هذه المناوبات:',(await dbAll('workers'))[0]?.name||'');
      if(!wn||!wn.trim())return;
      const name=wn.trim();
      const workers=await dbAll('workers');
      if(!workers.find(w=>w.name===name))await dbPut('workers',{id:uid(),name,createdAt:new Date().toISOString()});
      let n=0;
      for(const day of days){
        if(!/^\d{4}-\d{2}-\d{2}$/.test(String(day.date||'')))continue;
        let pq=0,dq=0;
        (day.pumps||[]).forEach(p=>{if(!isFilled(p.prev)||!isFilled(p.curr))return;
          const q=num(p.curr)-num(p.prev);if(q<0)return;
          if(p.type==='diesel')dq+=q;else pq+=q;});
        const sh={id:uid(),date:day.date,worker:name,
          prices:{petrol:day.prices?.petrol??0,diesel:day.prices?.diesel??0},
          meters:(day.pumps||[]).map(p=>({name:p.name||'مضخة',type:p.type==='diesel'?'diesel':'petrol',prev:p.prev,curr:p.curr})),
          reported:{petrol:String(pq),diesel:String(dq),cash:''},
          collections:(day.revenues||[]).map(r=>({person:r.person,amount:r.amount})),
          credits:[],expenses:(day.expenses||[]).map(e=>({reason:e.reason,person:e.person||'',amount:e.amount})),
          prevShortage:0,deposited:day.cashOnHand??0,imported:true,createdAt:new Date().toISOString()};
        await dbPut('shifts',sh);
        await postShiftLedger(sh);
        n++;
      }
      if(!n){toast('لا توجد أيام صالحة في الملف','bad');return;}
      toast('✅ تم استيراد '+n+' مناوبة للعامل '+name+' وترحيلها','good',5000);
      renderAll();
    }catch(e){toast('فشل: '+e.message,'bad',5000);}
  };
  rd.readAsText(file);
}

/* ================= التنقل والتهيئة ================= */
function switchTab(name){
  $$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));
  $$('.tab-panel').forEach(p=>p.classList.toggle('active',p.id==='tab-'+name));
  if(name==='day')renderDay();
  if(name==='workers')renderWorkers();
  if(name==='customers')renderCustomers();
  window.scrollTo({top:0});
}
async function renderAll(){renderDay();renderWorkers();renderCustomers();}
function bind(){
  $$('.nav-btn').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));
  $('#dayDate').addEventListener('change',e=>setDay(e.target.value));
  $('#btnDayToday').addEventListener('click',()=>setDay(todayISO()));
  $('#btnAddShift').addEventListener('click',()=>openShiftForm(null));
  $('#btnDayExcel').addEventListener('click',exportDayExcel);
  $('#btnDayPdf').addEventListener('click',printDay);
  $('#btnShiftBack').addEventListener('click',closeShiftForm);
  $('#btnShiftSave').addEventListener('click',saveShift);
  $('#btnAddMeter').addEventListener('click',()=>{formState.meters.push({name:'مضخة '+(formState.meters.length+1),type:'petrol',prev:'',curr:''});renderMeters();updateFormSummary();});
  $('#btnAddCollection').addEventListener('click',()=>{formState.collections.push({person:'',amount:''});renderCollections();});
  $('#btnAddCredit').addEventListener('click',()=>{formState.credits.push({person:'',amount:'',note:''});renderCredits();});
  $('#btnAddExpense').addEventListener('click',()=>{formState.expenses.push({reason:'',amount:'',person:''});renderExpenses();});
  ['fWorker','fDate','fPriceP','fPriceD','fRepP','fRepD','fRepCash','fPrevShort','fDeposited'].forEach(id=>{
    $('#'+id).addEventListener('input',updateFormSummary);
    $('#'+id).addEventListener('change',updateFormSummary);
  });
  $('#btnAddWorker').addEventListener('click',async()=>{
    const n=$('#newWorkerName').value.trim();
    if(!n){toast('اكتب اسم العامل','bad');return;}
    const all=await dbAll('workers');
    if(all.find(w=>w.name===n)){toast('الاسم موجود مسبقاً','bad');return;}
    await dbPut('workers',{id:uid(),name,createdAt:new Date().toISOString()});
    $('#newWorkerName').value='';toast('✅ تمت الإضافة','good');renderWorkers();
  });
  $('#btnAddCustomer').addEventListener('click',async()=>{
    const n=prompt('اسم العميل الجديد:');
    if(n&&n.trim()){
      await dbPut('customers',{id:uid(),name:n.trim(),opening:0,createdAt:new Date().toISOString()});
      renderCustomers();toast('✅ تمت الإضافة','good');
    }
  });
  $('#custSearch').addEventListener('input',renderCustomers);
  $('#btnPrintBalances').addEventListener('click',printBalances);
  $('#btnCustExcel').addEventListener('click',exportAllExcel);
  $('#btnExportAll').addEventListener('click',exportAllExcel);
  $('#btnBackup').addEventListener('click',backup);
  $('#btnRestore').addEventListener('click',()=>$('#restoreFile').click());
  $('#restoreFile').addEventListener('change',e=>{const f=e.target.files[0];if(f)restore(f);e.target.value='';});
  $('#btnImportWorker').addEventListener('click',()=>$('#importFile').click());
  $('#importFile').addEventListener('change',e=>{const f=e.target.files[0];if(f)importWorkerFile(f);e.target.value='';});
  $('#sheetClose').addEventListener('click',closeSheet);
  $('#sheetOverlay').addEventListener('click',e=>{if(e.target===$('#sheetOverlay'))closeSheet();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSheet();});
}
async function init(){
  bind();
  $('#dayDate').value=selectedDate;
  $('#headerDate').textContent=fmtDateAr(selectedDate);
  await renderAll();
}
init();
</script>
