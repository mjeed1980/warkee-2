  sh.meters.forEach((m,i)=>{const q=meterQty(m);const pr=m.type==='diesel'?num(sh.prices.diesel):num(sh.prices.petrol);
    exC(ws,r,1,i+1,{align:'center'});exC(ws,r,2,m.name);
