function downloadBlob(blob,name){
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;
  document.body.appendChild(a);a.click();
  setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},900);
}
const XLSX_TYPE='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
function exC(ws,r,c,v,o={}){
  const cell=ws.getCell(r,c);cell.value=v;
  const f={size:o.size||11};if(o.bold)f.bold=true;if(o.color)f.color={argb:o.color};cell.font=f;
  if(o.fill)cell.fill={type:'pattern',pattern:'solid',fgColor:{argb:o.fill}};
  if(o.numFmt)cell.numFmt=o.numFmt;
  cell.alignment={horizontal:o.align||'right',vertical:'middle'};
  if(o.border!==false)cell.border={top:{style:'hair'},bottom:{style:'hair'},left:{style:'hair'},right:{style:'hair'}};
}
function exHeader(ws,r,heads){
  heads.forEach((h,i)=>{const c=ws.getCell(r,i+1);c.value=h;
    c.font={bold:true,color:{argb:'FFFFFFFF'}};c.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF1E3A5F'}};
    c.alignment={horizontal:'center',vertical:'middle'};
    c.border={top:{style:'thin'},bottom:{style:'thin'},left:{style:'thin'},right:{style:'thin'}};});
  ws.getRow(r).height=22;
}
function exTitle(ws,t,cols){
  exC(ws,1,1,t,{bold:true,size:14,color:'FFFFFFFF',fill:'FF1E3A5F',align:'center',border:false});
  ws.mergeCells(1,1,1,cols);ws.getRow(1).height=28;
}
function csvCell(v){const s=String(v??'');return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;}
function toCSV(rows){return '\uFEFF'+rows.map(r=>r.map(csvCell).join(',')).join('\r\n');}
function dlCSV(rows,name){downloadBlob(new Blob([toCSV(rows)],{type:'text/csv;charset=utf-8'}),name);toast('تم التصدير CSV (يفتح في Excel)','good');}

