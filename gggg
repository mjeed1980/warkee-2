<script>
'use strict';
/* =====================================================================
   🧾 نظام مدير الحسابات — تشيك المناوبات + ترحيل كشوف العملاء
   ===================================================================== */
const $=(s)=>document.querySelector(s);
const $$=(s)=>Array.from(document.querySelectorAll(s));
const uid=()=>(crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2,9));
const PRICES_KEY='mgrPrices_v1';

function todayISO(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function num(v){const n=parseFloat(v);return isFinite(n)?n:0;}
function isFilled(v){return String(v??'').trim()!=='';}
function fmt(n){if(n==null||isNaN(n))return '—';return Number(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtQty(n){if(n==null||isNaN(n))return '—';return Number(n).toLocaleString('en-US',{maximumFractionDigits:2});}
function escapeHtml(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function fmtDateAr(iso){if(!iso)return '—';try{const d=new Date(iso+'T00:00:00');return isNaN(d.getTime())?iso:d.toLocaleDateString('ar-EG-u-nu-latn',{weekday:'long',day:'numeric',month:'long',year:'numeric'});}catch(e){return iso;}}
let toastTimer=null;
function toast(m,cls='',dur=3200){const el=$('#toast');el.textContent=m;el.className='toast '+cls;clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.className='toast',dur);}

/* ================= IndexedDB ================= */
const DB_NAME='stationManagerDB';
function openIDB(){
  return new Promise((res,rej)=>{
    const req=indexedDB.open(DB_NAME,1);
    req.onupgradeneeded=()=>{
      const db=req.result;
      if(!db.objectStoreNames.contains('shifts')){const s=db.createObjectStore('shifts',{keyPath:'id'});s.createIndex('date','date');}
      if(!db.objectStoreNames.contains('workers')) db.createObjectStore('workers',{keyPath:'id'});
      if(!db.objectStoreNames.contains('customers')) db.createObjectStore('customers',{keyPath:'id'});
      if(!db.objectStoreNames.contains('ledger')){const l=db.createObjectStore('ledger',{keyPath:'id'});l.createIndex('customerId','customerId');}
    };
    req.onsuccess=()=>res(req.result);
    req.onerror=()=>rej(req.error);
  });
}
function dbReq(store,mode,fn){
  return openIDB().then(db=>new Promise((resolve,reject)=>{
    const t=db.transaction(store,mode);
    const out=fn(t.objectStore(store));
    t.oncomplete=()=>{db.close();resolve(out&&out.result!==undefined?out.result:undefined);};
    t.onerror=()=>{db.close();reject(t.error);};
  }));
}
const dbAll=s=>dbReq(s,'readonly',st=>st.getAll());
const dbGet=(s,k)=>dbReq(s,'readonly',st=>st.get(k));
const dbPut=(s,o)=>dbReq(s,'readwrite',st=>st.put(o));
const dbDel=(s,k)=>dbReq(s,'readwrite',st=>st.delete(k));

/* ================= الحسابات ================= */
function meterQty(m){
  if(!isFilled(m.prev)||!isFilled(m.curr))return null;
  const a=parseFloat(m.prev),b=parseFloat(m.curr);
  if(isNaN(a)||isNaN(b))return null;
  return b-a;
}
function shiftCalc(sh){
  let pq=0,dq=0,pv=0,dv=0,neg=false;
  (sh.meters||[]).forEach(m=>{
    const q=meterQty(m);if(q===null)return;
    if(q<0){neg=true;return;}
    const price=m.type==='diesel'?num(sh.prices&&sh.prices.diesel):num(sh.prices&&sh.prices.petrol);
    if(m.type==='diesel'){dq+=q;dv+=q*price;}else{pq+=q;pv+=q*price;}
  });
  const collections=(sh.collections||[]).reduce((s,c)=>s+num(c.amount),0);
  const credits=(sh.credits||[]).reduce((s,c)=>s+num(c.amount),0);
  const expenses=(sh.expenses||[]).reduce((s,e)=>s+num(e.amount),0);
  const prevShortage=num(sh.prevShortage);
  const meterValue=pv+dv;
  const required=meterValue+collections-expenses-credits+prevShortage;
  const deposited=num(sh.deposited);
  const diff=required-deposited;
  const repP=sh.reported?num(sh.reported.petrol):0;
  const repD=sh.reported?num(sh.reported.diesel):0;
  const repCash=sh.reported?num(sh.reported.cash):0;
  return {pq,dq,pv,dv,meterValue,neg,collections,credits,expenses,prevShortage,required,deposited,diff,repP,repD,repCash,
    diffP:(repP>0||pq>0)?(repP-pq):0, diffD:(repD>0||dq>0)?(repD-dq):0};
}
function diffInfo(diff){
  if(diff>0.005)return{cls:'st-short',label:'نقص على العامل'};
  if(diff<-0.005)return{cls:'st-plus',label:'زيادة لدى العامل'};
  return{cls:'st-ok',label:'مطابق تماماً'};
}
async function lastOpenShortage(workerName,excludeId){
  const all=(await dbAll('shifts'))
    .filter(s=>s.worker===workerName&&s.id!==excludeId)
    .sort((a,b)=>a.date<b.date?1:a.date>b.date?-1:(a.createdAt<b.createdAt?1:-1));
  if(!all.length)return 0;
  const c=shiftCalc(all[0]);
  return c.diff>0.005?+c.diff.toFixed(2):0;
}
function dayTotals(list){
  const t={pq:0,dq:0,pv:0,dv:0,repP:0,repD:0,repCash:0,collections:0,credits:0,expenses:0,prevShortage:0,required:0,deposited:0,shortage:0,plus:0};
  list.forEach(sh=>{const c=shiftCalc(sh);
    t.pq+=c.pq;t.dq+=c.dq;t.pv+=c.pv;t.dv+=c.dv;t.repP+=c.repP;t.repD+=c.repD;t.repCash+=c.repCash;
    t.collections+=c.collections;t.credits+=c.credits;t.expenses+=c.expenses;t.prevShortage+=c.prevShortage;
    t.required+=c.required;t.deposited+=c.deposited;
    if(c.diff>0.005)t.shortage+=c.diff;else if(c.diff<-0.005)t.plus+=-c.diff;});
  return t;
}

/* ================= الترحيل لكشوف العملاء ================= */
async function ensureCustomer(name){
  const nm=String(name).trim();
  const all=await dbAll('customers');
  const f=all.find(c=>c.name.toLowerCase()===nm.toLowerCase());
  if(f)return f.id;
  const id=uid();
  await dbPut('customers',{id,name:nm,opening:0,createdAt:new Date().toISOString()});
  return id;
}
async function postShiftLedger(sh){
  const all=await dbAll('ledger');
  for(const e of all.filter(e=>e.shiftId===sh.id)) await dbDel('ledger',e.id);
  const post=async(list,kind)=>{
    for(const c of (list||[])){
      const amt=num(c.amount);
      if(!isFilled(c.person)||!(amt>0))continue;
      const cid=await ensureCustomer(c.person);
      await dbPut('ledger',{id:uid(),customerId:cid,date:sh.date,shiftId:sh.id,worker:sh.worker,
        desc:kind==='credit'?('بيع بالأجل'+(c.note?' — '+c.note:'')):('تحصيل دين'+(c.note?' — '+c.note:'')),
        debit:kind==='credit'?amt:0, credit:kind==='credit'?0:amt,
        createdAt:new Date().toISOString()});
    }
  };
  await post(sh.credits,'credit');
  await post(sh.collections,'collection');
}
async function customerEntries(cid){
  return (await dbAll('ledger')).filter(e=>e.customerId===cid)
    .sort((a,b)=>a.date<b.date?-1:a.date>b.date?1:(a.createdAt<b.createdAt?-1:1));
}
async function customerBalance(c,led){
  const entries=led||await customerEntries(c.id);
  return num(c.opening)+entries.reduce((s,e)=>s+num(e.debit)-num(e.credit),0);
}

/* ================= تبويب اليوم ================= */
let selectedDate=todayISO();
function setDay(d){selectedDate=d||todayISO();$('#dayDate').value=selectedDate;$('#headerDate').textContent=fmtDateAr(selectedDate);renderDay();}
async function renderDay(){
  const wrap=$('#dayShifts');
  try{
    const all=(await dbAll('shifts')).filter(s=>s.date===selectedDate)
      .sort((a,b)=>a.createdAt<b.createdAt?-1:1);
    const t=dayTotals(all);
    $('#dayTotals').innerHTML=
      '<div class="summary-grid">'+
      '<div class="sum-row"><span>بنزين عدادات</span><b>'+fmtQty(t.pq)+' لتر</b></div>'+
      '<div class="sum-row"><span>ديزل عدادات</span><b>'+fmtQty(t.dq)+' لتر</b></div>'+
      '<div class="sum-row total"><span>قيمة العدادات</span><b>'+fmt(t.pv+t.dv)+'</b></div>'+
      '<div class="sum-row"><span>تحصيلات</span><b class="pos">'+fmt(t.collections)+'</b></div>'+
      '<div class="sum-row"><span>بيع بالأجل</span><b class="neg">'+fmt(t.credits)+'</b></div>'+
      '<div class="sum-row"><span>مصروفات</span><b>'+fmt(t.expenses)+'</b></div>'+
      '<div class="sum-row total"><span>المطلوب الكلي</span><b>'+fmt(t.required)+'</b></div>'+
      '<div class="sum-row total"><span>المودَع الكلي</span><b>'+fmt(t.deposited)+'</b></div>'+
      '<div class="sum-row"><span>نقص مجمع</span><b class="neg">'+fmt(t.shortage)+'</b></div>'+
      '<div class="sum-row"><span>زيادات</span><b>'+fmt(t.plus)+'</b></div>'+
      '</div>';
    if(!all.length){wrap.innerHTML='<div class="card"><div class="empty-msg">لا توجد مناوبات لهذا اليوم — اضغط «➕ مناوبة جديدة»</div></div>';return;}
    wrap.innerHTML='';
    all.forEach(sh=>{
      const c=shiftCalc(sh),d=diffInfo(c.diff);
      const card=document.createElement('div');
      card.className='shift-card';
      let meters='<span class="k-badge kb-p">بنزين: '+fmtQty(c.pq)+' لتر ('+fmt(c.pv)+')</span>'+
                 '<span class="k-badge kb-d">ديزل: '+fmtQty(c.dq)+' لتر ('+fmt(c.dv)+')</span>';
      if(Math.abs(c.diffP)>0.005)meters+='<span class="warn">فرق بنزين: '+fmtQty(c.diffP)+'</span>';
      if(Math.abs(c.diffD)>0.005)meters+='<span class="warn">فرق ديزل: '+fmtQty(c.diffD)+'</span>';
      if(c.neg)meters+='<span class="warn">⚠️ قراءة حالية أقل من السابقة</span>';
      card.innerHTML=
        '<div class="sc-head"><div><div class="sc-worker">👷 '+escapeHtml(sh.worker)+'</div>'+
        '<div class="sc-date">📅 '+escapeHtml(sh.date)+'</div></div>'+
        '<span class="badge '+d.cls+'">'+d.label+' '+fmt(c.diff)+'</span></div>'+
        '<div class="sc-meters">'+meters+'</div>'+
        '<div class="sc-stats">'+
          '<div><span>المطلوب</span><b>'+fmt(c.required)+'</b></div>'+
          '<div><span>المودَع</span><b>'+fmt(c.deposited)+'</b></div>'+
          '<div><span>نقص محمَّل</span><b>'+fmt(c.prevShortage)+'</b></div>'+
          '<div><span>تحصيلات</span><b class="pos">'+fmt(c.collections)+'</b></div>'+
          '<div><span>ديون عملاء</span><b class="neg">'+fmt(c.credits)+'</b></div>'+
          '<div><span>مصروفات</span><b>'+fmt(c.expenses)+'</b></div>'+
        '</div>'+
        '<div class="sc-actions">'+
          '<button class="btn btn-small btn-edit" data-a="edit">✏️ تعديل</button>'+
          '<button class="btn btn-small btn-pdf" data-a="pdf">📄 PDF</button>'+
          '<button class="btn btn-small btn-xls" data-a="xls">📊 Excel</button>'+
          '<button class="btn btn-small btn-del" data-a="del">🗑️</button>'+
        '</div>';
      card.querySelector('[data-a="edit"]').addEventListener('click',()=>openShiftForm(sh.id));
      card.querySelector('[data-a="pdf"]').addEventListener('click',()=>printShift(sh.id));
      card.querySelector('[data-a="xls"]').addEventListener('click',()=>exportShiftExcel(sh.id));
      card.querySelector('[data-a="del"]').addEventListener('click',async()=>{
        if(!confirm('حذف مناوبة '+sh.worker+'؟ سيتم حذف حركاتها المُرحَّلة من كشوف العملاء.'))return;
        const led=await dbAll('ledger');
        for(const e of led.filter(e=>e.shiftId===sh.id))await dbDel('ledger',e.id);
        await dbDel('shifts',sh.id);
        toast('تم الحذف','good');renderDay();
      });
      wrap.appendChild(card);
    });
  }catch(e){wrap.innerHTML='<div class="card"><div class="empty-msg">⚠️ '+escapeHtml(e.message)+'</div></div>';}
}

/* ================= نموذج المناوبة ================= */
let formState=null,editingShiftId=null;
function emptyForm(date){
  const p=JSON.parse(localStorage.getItem(PRICES_KEY)||'{}');
  return {date:date||todayISO(),worker:'',prices:{petrol:p.petrol||'',diesel:p.diesel||''},
    meters:[{name:'مضخة 1',type:'petrol',prev:'',curr:''}],
    reported:{petrol:'',diesel:'',cash:''},collections:[],credits:[],expenses:[],
    prevShortage:0,deposited:''};
}
async function openShiftForm(shiftId){
  editingShiftId=shiftId||null;
  if(shiftId){
    const sh=await dbGet('shifts',shiftId);
    if(!sh){toast('السجل غير موجود','bad');return;}
    formState=JSON.parse(JSON.stringify(sh));
    $('#shiftPageTitle').textContent='✏️ تشيك مناوبة: '+sh.worker;
  }else{
    formState=emptyForm(selectedDate);
    $('#shiftPageTitle').textContent='➕ مناوبة جديدة';
  }
  // قائمة العمال
  const workers=await dbAll('workers');
  const sel=$('#fWorker');
  sel.innerHTML='<option value="">— اختر العامل —</option>'+workers.map(w=>'<option value="'+escapeHtml(w.name)+'">'+escapeHtml(w.name)+'</option>').join('');
  if(formState.worker)sel.value=formState.worker;
  else if(workers.length===1){sel.value=workers[0].name;formState.worker=workers[0].name;}
  $('#fDate').value=formState.date;
  $('#fPriceP').value=formState.prices.petrol;
  $('#fPriceD').value=formState.prices.diesel;
  $('#fRepP').value=formState.reported.petrol||'';
  $('#fRepD').value=formState.reported.diesel||'';
  $('#fRepCash').value=formState.reported.cash||'';
  $('#fPrevShort').value=formState.prevShortage||0;
  $('#fDeposited').value=formState.deposited;
  // نقص سابق مقترح لمناوبة جديدة
  if(!shiftId&&formState.worker){
    const s=await lastOpenShortage(formState.worker,null);
    if(s>0){formState.prevShortage=s;$('#fPrevShort').value=s;toast('تم تحميل نقص مفتوح سابق: '+fmt(s),'',4000);}
  }
  refreshDL();
  renderMeters();renderCollections();renderCredits();renderExpenses();updateFormSummary();
  $('#shiftPage').classList.remove('hidden');
  window.scrollTo({top:0});
}
function closeShiftForm(){$('#shiftPage').classList.add('hidden');formState=null;editingShiftId=null;}
function syncFormState(){
  formState.worker=$('#fWorker').value;
  formState.date=$('#fDate').value||todayISO();
  formState.prices.petrol=$('#fPriceP').value;
  formState.prices.diesel=$('#fPriceD').value;
  formState.reported={petrol:$('#fRepP').value,diesel:$('#fRepD').value,cash:$('#fRepCash').value};
  formState.prevShortage=$('#fPrevShort').value;
  formState.deposited=$('#fDeposited').value;
}
async function refreshDL(){
  const cs=await dbAll('customers');
  $('#customersDL').innerHTML=cs.map(c=>'<option value="'+escapeHtml(c.name)+'">').join('');
}
/* --- صفوف العدادات --- */
function updMeterRow(div,m){
  const el=div.querySelector('[data-qty]');const q=meterQty(m);
  el.classList.remove('ok','neg');
  if(q===null)el.textContent='الكمية: —';
  else if(q<0){el.textContent='الكمية: '+fmtQty(q)+' ⚠️';el.classList.add('neg');}
  else{el.textContent='الكمية: '+fmtQty(q)+' لتر';el.classList.add('ok');}
}
function renderMeters(){
  const wrap=$('#fMeters');wrap.innerHTML='';
  formState.meters.forEach(m=>{
    const div=document.createElement('div');div.className='pump-card';
    div.innerHTML=
      '<div class="pc-top"><input type="text" data-k="name" value="'+escapeHtml(m.name)+'" placeholder="اسم المضخة">'+
      '<button type="button" class="l-del">🗑️</button></div>'+
      '<div class="pc-mid"><div class="seg">'+
        '<button type="button" class="seg-btn t-petrol'+(m.type!=='diesel'?' on-petrol':'')+'">بنزين</button>'+
        '<button type="button" class="seg-btn t-diesel'+(m.type==='diesel'?' on-diesel':'')+'">ديزل</button>'+
      '</div><span class="qty-badge" data-qty>الكمية: —</span></div>'+
      '<div class="pc-bottom">'+
        '<div><label>السابقة</label><input type="number" inputmode="decimal" data-k="prev" value="'+escapeHtml(m.prev==null?'':m.prev)+'" step="any"></div>'+
        '<div><label>الحالية</label><input type="number" inputmode="decimal" data-k="curr" value="'+escapeHtml(m.curr==null?'':m.curr)+'" step="any"></div>'+
      '</div>';
    div.querySelectorAll('input[data-k]').forEach(inp=>inp.addEventListener('input',()=>{m[inp.dataset.k]=inp.value;updMeterRow(div,m);updateFormSummary();}));
    const bP=div.querySelector('.t-petrol'),bD=div.querySelector('.t-diesel');
    bP.addEventListener('click',()=>{m.type='petrol';bP.classList.add('on-petrol');bD.classList.remove('on-diesel');updMeterRow(div,m);updateFormSummary();});
    bD.addEventListener('click',()=>{m.type='diesel';bD.classList.add('on-diesel');bP.classList.remove('on-petrol');updMeterRow(div,m);updateFormSummary();});
    div.querySelector('.l-del').addEventListener('click',()=>{formState.meters=formState.meters.filter(x=>x!==m);renderMeters();updateFormSummary();});
    updMeterRow(div,m);wrap.appendChild(div);
  });
}
/* --- صفوف القوائم --- */
function renderList(wrapId, arr, gridHtml, bind){
  const wrap=$(wrapId);wrap.innerHTML='';
  if(!arr.length){wrap.innerHTML='<div class="empty-msg">لا توجد حركات — اضغط زر الإضافة</div>';return;}
  arr.forEach(o=>{
    const div=document.createElement('div');div.className='l-row';
    div.innerHTML=gridHtml(o);
    bind(div,o);
    div.querySelector('.l-del').addEventListener('click',()=>{
      formState[wrapId==='#fCollections'?'collections':wrapId==='#fCredits'?'credits':'expenses']
        =formState[wrapId==='#fCollections'?'collections':wrapId==='#fCredits'?'credits':'expenses'].filter(x=>x!==o);
      renderList(wrapId,arr,gridHtml,bind);updateFormSummary();
    });
    wrap.appendChild(div);
  });
}
function renderCollections(){
  renderList('#fCollections',formState.collections,o=>
    '<div class="lr-grid g3"><div><label>اسم العميل (اختياري)</label><input type="text" list="customersDL" data-k="person" value="'+escapeHtml(o.person||'')+'" placeholder="عميل أو فارغ"></div>'+
    '<div><label>المبلغ</label><input type="number" inputmode="decimal" data-k="amount" value="'+escapeHtml(o.amount==null?'':o.amount)+'" step="any"></div>'+
    '<button type="button" class="l-del">🗑️</button></div>',
  (div,o)=>div.querySelectorAll('input[data-k]').forEach(inp=>inp.addEventListener('input',()=>{o[inp.dataset.k]=inp.value;updateFormSummary();})));
}
function renderCredits(){
  renderList('#fCredits',formState.credits,o=>
    '<div><label>اسم العميل</label><input type="text" list="customersDL" data-k="person" value="'+escapeHtml(o.person||'')+'" placeholder="اسم العميل"></div>'+
    '<div class="lr-grid g3"><div><label>بيان (اختياري)</label><input type="text" data-k="note" value="'+escapeHtml(o.note||'')+'" placeholder="مثال: ديزل 100 لتر"></div>'+
    '<div><label>المبلغ</label><input type="number" inputmode="decimal" data-k="amount" value="'+escapeHtml(o.amount==null?'':o.amount)+'" step="any"></div>'+
    '<button type="button" class="l-del">🗑️</button></div>',
  (div,o)=>div.querySelectorAll('input[data-k]').forEach(inp=>inp.addEventListener('input',()=>{o[inp.dataset.k]=inp.value;updateFormSummary();})));
}
function renderExpenses(){
  renderList('#fExpenses',formState.expenses,o=>
    '<div class="lr-grid g3"><div><label>السبب / البيان</label><input type="text" data-k="reason" value="'+escapeHtml(o.reason||'')+'"></div>'+
    '<div><label>المبلغ</label><input type="number" inputmode="decimal" data-k="amount" value="'+escapeHtml(o.amount==null?'':o.amount)+'" step="any"></div>'+
    '<button type="button" class="l-del">🗑️</button></div>'+
    '<div><label>الشخص (اختياري)</label><input type="text" data-k="person" value="'+escapeHtml(o.person||'')+'"></div>',
  (div,o)=>div.querySelectorAll('input[data-k]').forEach(inp=>inp.addEventListener('input',()=>{o[inp.dataset.k]=inp.value;updateFormSummary();})));
}
function updateFormSummary(){
  if(!formState)return;
  syncFormState();
  const tmp={meters:formState.meters,prices:formState.prices,collections:formState.collections,
    credits:formState.credits,expenses:formState.expenses,prevShortage:formState.prevShortage,
    deposited:formState.deposited,reported:formState.reported};
